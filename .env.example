APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Service Configuration (Default: SMTP)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="web@vignan.ac.in"
MAIL_FROM_NAME="Vignan University LMS"

# --- Example Mail Templates ---
# Option A: Gmail SMTP (Use Google Account 16-character App Password)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_gmail_address@gmail.com
# MAIL_PASSWORD=your_16_char_app_password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=web@vignan.ac.in
# MAIL_FROM_NAME="Vignan University LMS"

# Option B: Vignan / Microsoft Office 365 Exchange SMTP
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USERNAME=web@vignan.ac.in
# MAIL_PASSWORD=your_smtp_app_password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=web@vignan.ac.in
# MAIL_FROM_NAME="Vignan University LMS"

# Option C: Local Development with Mailpit
# MAIL_MAILER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Discord Real-Time Error & Exception Webhook Monitor
DISCORD_ERROR_WEBHOOK_ENABLED=true
DISCORD_ERROR_WEBHOOK_URL=
DISCORD_ERROR_WEBHOOK_BOT_NAME="LMS Dev Monitor"
DISCORD_ERROR_WEBHOOK_RATE_LIMIT=30
DISCORD_WEBHOOK_INCLUDE_BODY=true

# Admin Email Alerting (web@vignan.ac.in)
ADMIN_ALERT_EMAIL=web@vignan.ac.in

# JioCX SMS Gateway
JIOCX_SMS_URL=https://smsapi.jiocx.com/apggw/vignans/sms/v1/send
JIOCX_SMS_USERNAME=jiocx-vignans
JIOCX_SMS_PASSWORD=
JIOCX_SMS_SENDER_ID=VIGNAN
JIOCX_DLT_ENTITY_ID=1101385640000011255
JIOCX_DLT_TEMPLATE_ID_Create_Account=1777179265526294215
